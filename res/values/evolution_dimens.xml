<resources>
    <!-- Model page hero. Stock M3E shape tokens; inner radii are concentric with the hero
         (hero 48 - padding 20 = 28). -->
    <dimen name="model_hero_radius">48dp</dimen>
    <dimen name="model_hero_padding">20dp</dimen>
    <!-- Square box for the cookie-shaped device tile; the photo is fit inside, never cropped. -->
    <dimen name="model_tile_size">120dp</dimen>
    <!-- Image inset inside the tile so a tall phone's corners stay within the cookie lobes. -->
    <dimen name="model_tile_image_inset">20dp</dimen>
    <!-- Loader fills the tile; the indicator is 79% of this (M3E 38dp in 48dp). -->
    <dimen name="model_loader_size">@dimen/model_tile_size</dimen>
    <dimen name="model_maintainer_radius">28dp</dimen>
    <dimen name="model_chip_radius">12dp</dimen>
    <!-- Segmented spec rows: inner corner at rest, and the shape a pressed row morphs to. -->
    <dimen name="model_row_inner_radius">4dp</dimen>
    <dimen name="model_row_pressed_radius">16dp</dimen>
    <!-- How far the hero surfaces rise while fading in. -->
    <dimen name="model_rise_offset">12dp</dimen>
    <!-- Cap for a spec row label so a long label cannot squeeze its value at large font sizes. -->
    <dimen name="model_spec_label_max_width">144dp</dimen>
</resources>

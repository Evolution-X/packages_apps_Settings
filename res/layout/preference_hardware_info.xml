<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/settingslib_expressive_space_small1">

            <!-- ======================================================== -->
            <!-- Hero: ONE flat tonal surface (primaryContainer) with      -->
            <!-- equal 40dp corners: device tile, headline, status pill,   -->
            <!-- maintainer.                                               -->
            <!-- ======================================================== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settingslib_expressive_space_extrasmall4"
                android:background="@drawable/model_hero_background"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/settingslib_expressive_space_small1">

                            <!-- Device tile: placeholder -> shape-morphing loader -> image -->
                            <FrameLayout
                                android:layout_width="96dp"
                                android:layout_height="128dp"
                                android:background="@drawable/model_tile_background"
                                android:clipToOutline="true">

                                <ImageView
                                    android:id="@+id/device_image_placeholder"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_model_phone" />

                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/device_image_loading"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:visibility="gone"
                                    app:lottie_loop="true"
                                    app:lottie_rawRes="@raw/model_loading_shapes_expressive" />

                                <ImageView
                                    android:id="@+id/device_image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:alpha="0"
                                    android:contentDescription="@null"
                                    android:padding="6dp"
                                    android:scaleType="fitCenter" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/settingslib_expressive_space_small1"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingTop="32dp">

                                <TextView
                                    android:id="@+id/model_headline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="variable-display-small-emphasized"
                                    android:maxLines="2"
                                    android:textAppearance="@style/TextAppearance.SettingsLib.DisplaySmall"
                                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/oem_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
                                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                                    android:visibility="gone" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Status pill -->
                        <TextView
                            android:id="@+id/model_status_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="16dp"
                            android:background="@drawable/model_status_pill_background"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textAppearance="@style/TextAppearance.SettingsLib.BodySmall.Emphasized"
                            android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Maintainer row (divider + row share one click target) -->
                    <LinearLayout
                        android:id="@+id/maintainer_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:background="?android:attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/settingslib_expressive_space_small1"
                            android:alpha="0.2"
                            android:background="@color/settingslib_materialColorOnPrimaryContainer" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/settingslib_expressive_space_small1"
                            android:paddingVertical="@dimen/settingslib_expressive_space_extrasmall6">

                            <!-- Initial sits underneath; the GitHub avatar covers it once loaded -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp">

                                <TextView
                                    android:id="@+id/maintainer_avatar_initial"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/model_avatar_initial_background"
                                    android:gravity="center"
                                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium.Emphasized"
                                    android:textColor="@color/settingslib_materialColorOnPrimary" />

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/maintainer_avatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/settingslib_expressive_space_extrasmall6"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/maintainer_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />

                                <!-- Shown only when currently_maintained=true -->
                                <ImageView
                                    android:id="@+id/maintainer_verified_badge"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="@dimen/settingslib_expressive_space_extrasmall4"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check_circle_filled_24dp"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <!-- Plain chevron, shown when the row is tappable -->
                            <ImageView
                                android:id="@+id/maintainer_chevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/settingslib_expressive_icon_chevron"
                                android:tint="@color/settingslib_materialColorOnPrimaryContainer"
                                android:visibility="gone" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- ======================================================== -->
            <!-- Specs: segmented rows (outer 28 / inner 4, shaped in      -->
            <!-- code from model_spec_row so optional rows leave no gaps)  -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/settingslib_expressive_space_small1"
                    android:paddingTop="@dimen/settingslib_expressive_space_small1"
                    android:paddingBottom="@dimen/settingslib_expressive_space_extrasmall4"
                    android:text="@string/model_hardware_section"
                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium.Emphasized"
                    android:textColor="@color/settingslib_materialColorPrimary" />

                <LinearLayout
                    android:id="@+id/specs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

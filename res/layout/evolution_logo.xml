<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/evolution_logo_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.android.settings.deviceinfo.firmwareversion.GlowView
        android:id="@+id/evolution_rgb_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <ImageView
        android:id="@+id/evolution_logo_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_evolution_logo_outline"
        android:tint="?android:attr/textColorPrimary" />

</FrameLayout>
